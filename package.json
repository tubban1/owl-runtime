{
  "name": "owl-runtime",
  "version": "1.0.0-rc.4",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "PORT=${PORT:-8788} OWL_RUNTIME_MODE=development OWL_STATE_ROOT=${AGENTOS_STATE_ROOT:-$HOME/.owl-runtime-dev} tsx watch src/server.ts",
    "dev:mcp": "PORT=${PORT:-8789} OWL_RUNTIME_MODE=development OWL_STATE_ROOT=${AGENTOS_STATE_ROOT:-$HOME/.owl-runtime-dev} tsx watch src/mcp-server.ts",
    "dev:isolated": "npm run dev",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.public.json",
    "start": "OWL_RUNTIME_MODE=production node dist/server.js",
    "start:mcp": "OWL_RUNTIME_MODE=production node dist/mcp-server.js",
    "start:source": "PORT=${PORT:-8788} OWL_RUNTIME_MODE=development OWL_STATE_ROOT=${AGENTOS_STATE_ROOT:-$HOME/.owl-runtime-dev} tsx src/server.ts",
    "start:mcp:source": "PORT=${PORT:-8789} OWL_RUNTIME_MODE=development OWL_STATE_ROOT=${AGENTOS_STATE_ROOT:-$HOME/.owl-runtime-dev} tsx src/mcp-server.ts",
    "typecheck": "tsc --noEmit",
    "verify:isa": "OWL_RUNTIME_MODE=test tsx scripts/verify-primitive-isa.ts",
    "verify:skill-abi": "OWL_RUNTIME_MODE=test tsx scripts/verify-skill-abi.ts",
    "verify:user-skills": "OWL_RUNTIME_MODE=test tsx scripts/verify-user-skill-registry.ts",
    "verify:workflow-discovery": "OWL_RUNTIME_MODE=test tsx scripts/verify-workflow-skill-discovery.ts",
    "verify:public-events": "OWL_RUNTIME_MODE=test tsx scripts/verify-public-event-journal.ts",
    "verify:request-replay": "OWL_RUNTIME_MODE=test tsx scripts/verify-request-replay.ts",
    "verify:task-memory": "OWL_RUNTIME_MODE=test tsx scripts/verify-task-memory.ts",
    "verify:scheduler": "OWL_RUNTIME_MODE=test tsx scripts/verify-scheduler.ts",
    "verify:loop": "OWL_RUNTIME_MODE=test tsx scripts/verify-loop.ts",
    "verify:semantic-memory": "OWL_RUNTIME_MODE=test tsx scripts/verify-semantic-memory.ts",
    "verify:recall": "OWL_RUNTIME_MODE=test tsx scripts/verify-recall.ts",
    "verify:session-adapters": "OWL_RUNTIME_MODE=test tsx scripts/verify-session-adapters.ts",
    "verify:identity": "OWL_RUNTIME_MODE=test tsx scripts/verify-runtime-identity.ts",
    "verify:embedding-provider": "OWL_RUNTIME_MODE=test tsx scripts/verify-embedding-provider.ts",
    "verify:wechat-session": "OWL_RUNTIME_MODE=test tsx scripts/verify-wechat-session.ts",
    "verify:macos-helper": "xcrun swiftc -frontend -parse macos-helper/ComputerMCPHelper.swift",
    "verify:concurrency": "OWL_RUNTIME_MODE=test tsx scripts/verify-concurrency.ts",
    "verify:production-runtime": "npm run build && OWL_RUNTIME_MODE=test tsx scripts/verify-production-runtime.ts",
    "verify:drain-handoff": "OWL_RUNTIME_MODE=test tsx scripts/verify-drain-handoff.ts",
    "verify:fault-recovery": "OWL_RUNTIME_MODE=test tsx scripts/verify-fault-recovery.ts",
    "verify:recovery-matrix": "npm run verify:fault-recovery && npm run verify:concurrency && npm run verify:session-adapters && npm run verify:wechat-session && npm run verify:state-schema",
    "soak:smoke": "OWL_RUNTIME_MODE=test SOAK_PROFILE=smoke tsx scripts/soak-runtime.ts",
    "soak:2h": "OWL_RUNTIME_MODE=test SOAK_PROFILE=2h tsx scripts/soak-runtime.ts",
    "soak:6h": "OWL_RUNTIME_MODE=test SOAK_PROFILE=6h tsx scripts/soak-runtime.ts",
    "soak:24h": "OWL_RUNTIME_MODE=test SOAK_PROFILE=24h tsx scripts/soak-runtime.ts",
    "soak:status": "node scripts/soak-status.mjs",
    "verify:state-schema": "OWL_RUNTIME_MODE=test tsx scripts/verify-state-schema.ts",
    "verify:upgrade-runtime": "npm run build && OWL_RUNTIME_MODE=test tsx scripts/verify-upgrade-runtime.ts",
    "install:runtime-host": "zsh scripts/install-macos-runtime-host.sh",
    "verify:runtime-host": "xcrun swiftc -frontend -parse macos-runtime-host/OwlRuntimeHost.swift && OWL_RUNTIME_MODE=test tsx scripts/verify-runtime-host.ts",
    "install:production": "bash scripts/install-production-runtime.sh",
    "upgrade:production": "bash scripts/upgrade-production-runtime.sh",
    "status:production": "bash scripts/status-production-runtime.sh",
    "uninstall:production": "bash scripts/uninstall-production-runtime.sh",
    "verify:observation-abi": "OWL_RUNTIME_MODE=test tsx scripts/verify-observation-abi.ts",
    "verify:verifier-abi": "OWL_RUNTIME_MODE=test tsx scripts/verify-verifier-abi.ts",
    "verify:process-state": "OWL_RUNTIME_MODE=test tsx scripts/verify-process-state-machine.ts",
    "verify:approval-policy": "OWL_RUNTIME_MODE=test tsx scripts/verify-approval-policy.ts",
    "verify:health-model": "OWL_RUNTIME_MODE=test tsx scripts/verify-health-model.ts",
    "verify:action-observation": "OWL_RUNTIME_MODE=test tsx scripts/verify-action-observation.ts",
    "verify:browser-postconditions": "OWL_RUNTIME_MODE=test tsx scripts/verify-browser-postconditions.ts",
    "verify:public-runtime-client": "OWL_RUNTIME_MODE=test tsx scripts/verify-public-runtime-client.ts",
    "build:types": "tsc -p tsconfig.public.json",
    "prepack": "npm run build",
    "verify:http-runtime-client": "OWL_RUNTIME_MODE=test tsx scripts/verify-http-runtime-client.ts",
    "verify:process-control": "OWL_RUNTIME_MODE=test tsx scripts/verify-process-control-capability.ts",
    "verify:request-cancellation": "OWL_RUNTIME_MODE=test tsx scripts/verify-request-cancellation.ts",
    "verify:execution-target": "OWL_RUNTIME_MODE=test tsx scripts/verify-execution-target.ts",
    "verify:support-package": "OWL_RUNTIME_MODE=test tsx scripts/verify-support-package.ts",
    "verify:browser-cancellation": "OWL_RUNTIME_MODE=test tsx scripts/verify-browser-cancellation.ts",
    "verify:desktop-postconditions": "OWL_RUNTIME_MODE=test tsx scripts/verify-desktop-postconditions.ts",
    "verify:rc-fast": "node scripts/verify-release-candidate.mjs",
    "verify:rc": "npm run verify:rc-fast && npm run soak:smoke",
    "verify:execution-revision": "OWL_RUNTIME_MODE=test tsx scripts/verify-execution-revision.ts",
    "verify:execution-activation": "OWL_RUNTIME_MODE=test tsx scripts/verify-execution-activation.ts",
    "verify:approval-resume": "OWL_RUNTIME_MODE=test tsx scripts/verify-approval-resume.ts",
    "verify:public-dto": "OWL_RUNTIME_MODE=test tsx scripts/verify-public-dto.ts",
    "verify:storage-foundation": "OWL_RUNTIME_MODE=test tsx scripts/verify-storage-foundation.ts",
    "verify:storage-retention": "OWL_RUNTIME_MODE=test tsx scripts/verify-storage-retention.ts",
    "verify:legacy-storage-migration": "OWL_RUNTIME_MODE=test tsx scripts/verify-legacy-storage-migration.ts",
    "verify:schedule-pause-resume": "OWL_RUNTIME_MODE=test tsx scripts/verify-schedule-pause-resume.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.4",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "playwright-core": "^1.63.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "types": "./dist/public/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/public/index.d.ts",
      "import": "./dist/public/index.js"
    },
    "./client": {
      "types": "./dist/public/index.d.ts",
      "import": "./dist/public/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ]
}
