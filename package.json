{
  "name": "owl-runtime",
  "version": "0.10.0-dev.0",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "PORT=${PORT:-8788} OWL_RUNTIME_MODE=development OWL_STATE_ROOT=${AGENTOS_STATE_ROOT:-$HOME/.owl-runtime-dev} tsx watch src/server.ts",
    "dev:isolated": "npm run dev",
    "build": "tsc -p tsconfig.json",
    "start": "OWL_RUNTIME_MODE=production node dist/server.js",
    "start:source": "PORT=${PORT:-8788} OWL_RUNTIME_MODE=development OWL_STATE_ROOT=${AGENTOS_STATE_ROOT:-$HOME/.owl-runtime-dev} tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "verify:isa": "OWL_RUNTIME_MODE=test tsx scripts/verify-primitive-isa.ts",
    "verify:skill-abi": "OWL_RUNTIME_MODE=test tsx scripts/verify-skill-abi.ts",
    "verify:task-memory": "OWL_RUNTIME_MODE=test tsx scripts/verify-task-memory.ts",
    "verify:scheduler": "OWL_RUNTIME_MODE=test tsx scripts/verify-scheduler.ts",
    "verify:loop": "OWL_RUNTIME_MODE=test tsx scripts/verify-loop.ts",
    "verify:semantic-memory": "OWL_RUNTIME_MODE=test tsx scripts/verify-semantic-memory.ts",
    "verify:recall": "OWL_RUNTIME_MODE=test tsx scripts/verify-recall.ts",
    "verify:session-adapters": "OWL_RUNTIME_MODE=test tsx scripts/verify-session-adapters.ts",
    "verify:identity": "OWL_RUNTIME_MODE=test tsx scripts/verify-runtime-identity.ts",
    "verify:embedding-provider": "OWL_RUNTIME_MODE=test tsx scripts/verify-embedding-provider.ts",
    "verify:wechat-session": "OWL_RUNTIME_MODE=test tsx scripts/verify-wechat-session.ts",
    "verify:macos-helper": "xcrun swiftc -frontend -parse macos-helper/ComputerMCPHelper.swift",
    "verify:concurrency": "OWL_RUNTIME_MODE=test tsx scripts/verify-concurrency.ts",
    "verify:production-runtime": "npm run build && OWL_RUNTIME_MODE=test tsx scripts/verify-production-runtime.ts",
    "verify:drain-handoff": "OWL_RUNTIME_MODE=test tsx scripts/verify-drain-handoff.ts",
    "verify:fault-recovery": "OWL_RUNTIME_MODE=test tsx scripts/verify-fault-recovery.ts",
    "verify:recovery-matrix": "npm run verify:fault-recovery && npm run verify:concurrency && npm run verify:session-adapters && npm run verify:wechat-session && npm run verify:state-schema",
    "soak:smoke": "OWL_RUNTIME_MODE=test SOAK_PROFILE=smoke tsx scripts/soak-runtime.ts",
    "soak:2h": "OWL_RUNTIME_MODE=test SOAK_PROFILE=2h tsx scripts/soak-runtime.ts",
    "soak:6h": "OWL_RUNTIME_MODE=test SOAK_PROFILE=6h tsx scripts/soak-runtime.ts",
    "soak:24h": "OWL_RUNTIME_MODE=test SOAK_PROFILE=24h tsx scripts/soak-runtime.ts",
    "soak:status": "node scripts/soak-status.mjs",
    "verify:state-schema": "OWL_RUNTIME_MODE=test tsx scripts/verify-state-schema.ts",
    "verify:upgrade-runtime": "npm run build && OWL_RUNTIME_MODE=test tsx scripts/verify-upgrade-runtime.ts",
    "install:production": "bash scripts/install-production-runtime.sh",
    "upgrade:production": "bash scripts/upgrade-production-runtime.sh",
    "status:production": "bash scripts/status-production-runtime.sh",
    "uninstall:production": "bash scripts/uninstall-production-runtime.sh",
    "verify:observation-abi": "OWL_RUNTIME_MODE=test tsx scripts/verify-observation-abi.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.4",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "playwright-core": "^1.63.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
