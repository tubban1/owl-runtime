PORT=8787
# Graceful production-upgrade drain wait. Default: 120000 ms.
# AGENTOS_UPGRADE_DRAIN_TIMEOUT_MS=120000

# Absolute paths only, comma-separated. Keep this as narrow as practical.
ALLOWED_DIRECTORIES=/Users/yourname/Documents/Projects

# Filesystem writes are enabled by default. Set false to force read-only mode.
ALLOW_WRITE=true

# High-risk capabilities are off by default.
ALLOW_DELETE=false
ALLOW_SHELL=false
ALLOW_GIT_PUSH=false
ALLOW_ROLLBACK=false
ALLOW_BROWSER=false
ALLOW_GUI=false

# Privacy-aware JSONL audit log. Sensitive payloads such as file contents,
# patches, shell commands and process input are hashed/redacted.
AUDIT_LOG_ENABLED=true
# Optional override. Default: ~/.computer-mcp/audit.jsonl
# AUDIT_LOG_PATH=/Users/yourname/.computer-mcp/audit.jsonl

# Workspace session-only leases are reclaimed after an MCP transport is explicitly disconnected and this reconnect grace has elapsed. Default: 5000 ms.
# WORKSPACE_SESSION_RECLAIM_GRACE_MS=5000
# Session-only lease fallback when a transport remains apparently active but idle after stream/network recovery. Default: 15 minutes.
# WORKSPACE_SESSION_IDLE_RECLAIM_MS=900000

# Optional override for transaction metadata and staged patches.
# Default: ~/.computer-mcp/transactions
# TRANSACTION_DIR=/Users/yourname/.computer-mcp/transactions

# Browser provider (Chromium-based browser via playwright-core)
# Default mode. v0.9 callers can override headless per browser.open / web.open call.
BROWSER_HEADLESS=false
# Maximum wait for Chrome DevTools Protocol during startup. Default: 60000.
# BROWSER_STARTUP_TIMEOUT_MS=60000
# Maximum Playwright connectOverCDP handshake wait. Default: 30000.
# BROWSER_CONNECT_TIMEOUT_MS=30000
# Optional explicit browser executable. Auto-detected on macOS if omitted.
# BROWSER_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Optional persistent browser profile. If omitted, computer-mcp uses the stable
# Runtime-owned profile ~/.computer-mcp/browser-profiles/default so authenticated
# browser sessions survive computer-mcp restarts.
# BROWSER_PROFILE_DIR=/Users/yourname/.computer-mcp/browser-profiles/default

# macOS Desktop Perception.
# v0.9.2 prefers the standalone Computer MCP Helper.app so GUI permissions do
# not depend on whether computer-mcp was launched from Terminal, Antigravity,
# Cursor, launchd, or another parent app.
# Modes: auto (default, helper with fallback), required, disabled.
MACOS_HELPER_MODE=auto
# Default app: ~/Applications/Computer MCP Helper.app
# COMPUTER_MCP_HELPER_APP=/Users/yourname/Applications/Computer MCP Helper.app
# Default socket: ~/.computer-mcp/helper.sock
# COMPUTER_MCP_HELPER_SOCKET=/Users/yourname/.computer-mcp/helper.sock

# Persistent tasks (v0.8)
# Task definitions, runtime state, and step outputs are encrypted at rest.
# Default: ~/.computer-mcp/tasks
# TASK_DIR=/Users/yourname/.computer-mcp/tasks

# Auto-generated AES-256-GCM key. Keep this file private and backed up if
# persistent task recovery matters across machine migrations.
# Default: ~/.computer-mcp/task.key
# TASK_KEY_PATH=/Users/yourname/.computer-mcp/task.key


# Persistent task staging (v0.9.5)
# File-backed intermediate assets for durable tasks.
# Default: ~/.computer-mcp/staging
# TASK_STAGING_DIR=/Users/yourname/.computer-mcp/staging
# Automatically copy result files up to 256 MiB into staging.
# TASK_STAGING_MAX_AUTO_COPY_BYTES=268435456
# Allow filesystem/browser primitives to consume files inside the runtime-owned
# staging root. Set false if staged assets should be preservation-only.
TASK_STAGING_EXPOSE_TO_FS=true

# Persistent wake scheduler (v0.9.6)
# Encrypted schedule definitions. These are Runtime-owned internal state and are
# not automatically exposed as general filesystem roots.
# Default: ~/.computer-mcp/schedules
# SCHEDULER_DIR=/Users/yourname/.computer-mcp/schedules
# Default: ~/.computer-mcp/schedule.key
# SCHEDULER_KEY_PATH=/Users/yourname/.computer-mcp/schedule.key
# Scheduler wake poll. Default 5000 ms, bounded to 1000..60000.
# SCHEDULER_POLL_MS=5000


# Semantic Memory (v0.9.8)
# Encrypted Runtime-owned M3 store. It is not part of ALLOWED_DIRECTORIES.
# Default: ~/.computer-mcp/semantic
# SEMANTIC_MEMORY_DIR=/Users/yourname/.computer-mcp/semantic
# Default key: ~/.computer-mcp/semantic.key
# SEMANTIC_MEMORY_KEY_PATH=/Users/yourname/.computer-mcp/semantic.key


# Runtime identity / wake alias (v0.9.9)
# Formal product name remains AgentOS Runtime.
# AGENTOS_NAME=AgentOS Runtime
# Say this name in a chat where computer-mcp is connected to invoke the Runtime.
# AGENTOS_WAKE_NAME=Jarvis
# Optional comma-separated aliases.
# AGENTOS_ALIASES=AgentOS,OWL,Jarvis

# Global Episodic Index + Recall (v0.9.9)
# Encrypted cross-task M2 terminal episode index.
# EPISODIC_INDEX_DIR=/Users/yourname/.computer-mcp/episodes
# EPISODIC_INDEX_KEY_PATH=/Users/yourname/.computer-mcp/episode.key

# Session Adapter Contract (v0.9.9)
# Encrypted ChatGPT / Antigravity / generic browser bindings and turn receipts.
# SESSION_ADAPTER_DIR=/Users/yourname/.computer-mcp/sessions
# SESSION_ADAPTER_KEY_PATH=/Users/yourname/.computer-mcp/session.key

# Antigravity adapter overrides. Defaults are generic and can be updated if its DOM changes.
# ANTIGRAVITY_URL_PATTERN=antigravity
# ANTIGRAVITY_INPUT_SELECTOR=textarea
# ANTIGRAVITY_SEND_SELECTOR=button[type="submit"]
# ANTIGRAVITY_MESSAGE_SELECTOR=[data-role="assistant"]
# ANTIGRAVITY_BUSY_MARKERS=stop generating,stop response,cancel generation


# Embedding Provider Contract (v0.9.10)
# Default stays fully local and zero-dependency.
EMBEDDING_PROVIDER=feature-hash
# Fallback when a configured provider is unavailable. Set "none" for strict mode.
EMBEDDING_FALLBACK_PROVIDER=feature-hash
# Generic OpenAI-compatible local endpoint.
# EMBEDDING_BASE_URL=http://127.0.0.1:8080/v1
# EMBEDDING_MODEL=local-embedding-model
# EMBEDDING_API_KEY=
# EMBEDDING_DIMENSIONS=
# Ollama embeddings. Loopback is local; remote Ollama hosts use the same explicit
# EMBEDDING_ALLOW_REMOTE gate.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OpenAI embeddings. Remote memory text egress is disabled unless explicitly enabled.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIMENSIONS=
EMBEDDING_ALLOW_REMOTE=false

# Persistent low-interruption WeChat sessions (v0.9.10)
# Encrypted bindings, digests, turn receipts and uncertain-send state.
# WECHAT_SESSION_DIR=/Users/yourname/.computer-mcp/wechat-sessions
# WECHAT_SESSION_KEY_PATH=/Users/yourname/.computer-mcp/wechat-session.key
# Test-only OCR fixture hook; do not configure in normal Runtime environments.
# COMPUTER_MCP_TEST_WECHAT_OCR_FIXTURE=
